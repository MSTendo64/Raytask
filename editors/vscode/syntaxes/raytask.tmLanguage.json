{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "RayTask",
  "scopeName": "source.raytask",
  "patterns": [
    { "include": "#comments" },
    { "include": "#preprocessor" },
    { "include": "#attributes" },
    { "include": "#strings" },
    { "include": "#numbers" },
    { "include": "#keywords" },
    { "include": "#types" },
    { "include": "#constants" },
    { "include": "#functions" },
    { "include": "#operators" }
  ],
  "repository": {
    "comments": {
      "patterns": [
        {
          "name": "comment.block.documentation.raytask",
          "begin": "///",
          "end": "$",
          "patterns": [{ "include": "#strings" }]
        },
        {
          "name": "comment.line.double-slash.raytask",
          "match": "//.*$"
        },
        {
          "name": "comment.block.raytask",
          "begin": "/\\*",
          "end": "\\*/"
        }
      ]
    },
    "preprocessor": {
      "name": "meta.preprocessor.raytask",
      "match": "^\\s*#(if|elif|else|endif|pragma)\\b.*$"
    },
    "attributes": {
      "name": "meta.attribute.raytask",
      "begin": "\\[",
      "end": "\\]",
      "patterns": [
        {
          "name": "entity.name.function.attribute.raytask",
          "match": "\\b(test|export|entry|DllImport|link|include|c|cembed|embed|interrupt|address|no_gc|optimize|debug|target|abi|symbol|name)\\b"
        },
        { "include": "#strings" },
        { "include": "#numbers" }
      ]
    },
    "strings": {
      "patterns": [
        {
          "name": "string.quoted.double.interpolated.raytask",
          "begin": "\\$\"",
          "end": "\"",
          "patterns": [
            {
              "name": "constant.character.escape.raytask",
              "match": "\\\\."
            },
            {
              "name": "meta.interpolation.raytask",
              "begin": "\\{",
              "end": "\\}",
              "patterns": [
                { "include": "#keywords" },
                { "include": "#numbers" },
                { "include": "#constants" }
              ]
            }
          ]
        },
        {
          "name": "string.quoted.double.raytask",
          "begin": "\"",
          "end": "\"",
          "patterns": [
            {
              "name": "constant.character.escape.raytask",
              "match": "\\\\."
            }
          ]
        },
        {
          "name": "string.quoted.single.raytask",
          "match": "'(\\\\.|[^\\\\'])'"
        },
        {
          "name": "string.quoted.raw.raytask",
          "begin": "@\"",
          "end": "\""
        }
      ]
    },
    "numbers": {
      "patterns": [
        {
          "name": "constant.numeric.hex.raytask",
          "match": "\\b0[xX][0-9A-Fa-f_]+\\b"
        },
        {
          "name": "constant.numeric.binary.raytask",
          "match": "\\b0[bB][01_]+\\b"
        },
        {
          "name": "constant.numeric.float.raytask",
          "match": "\\b\\d[\\d_]*\\.\\d[\\d_]*([eE][+-]?\\d+)?[fFdDmM]?\\b"
        },
        {
          "name": "constant.numeric.integer.raytask",
          "match": "\\b\\d[\\d_]*([uUlL]|ul|UL)?\\b"
        }
      ]
    },
    "keywords": {
      "patterns": [
        {
          "name": "keyword.control.raytask",
          "match": "\\b(if|else|switch|case|default|break|continue|for|foreach|while|do|return|try|catch|finally|throw|match|await)\\b"
        },
        {
          "name": "keyword.other.raytask",
          "match": "\\b(import|namespace|module|export|protected|private|class|struct|interface|abstract|virtual|override|new|base|this|super|property|get|set|where|operator|params|using|unsafe|stack|owned|async|var|dyn|const|is|as|typeof|sizeof|in)\\b"
        },
        {
          "name": "storage.modifier.raytask",
          "match": "\\b(export|protected|private|abstract|virtual|override|async|unsafe|stack|owned)\\b"
        }
      ]
    },
    "types": {
      "name": "support.type.raytask",
      "match": "\\b(void|bool|byte|sbyte|short|ushort|int|uint|long|ulong|float|double|decimal|char|string|ptr|List|Dictionary|Set|Queue|Stack|Task|Result|DateTime|File|Directory|StringBuilder|Logger|Http|Json|Yaml|Math|Random|Hash|Gc|GC|Object|Exception)\\b"
    },
    "constants": {
      "name": "constant.language.raytask",
      "match": "\\b(true|false|null|this|base|super)\\b"
    },
    "functions": {
      "patterns": [
        {
          "name": "entity.name.function.raytask",
          "match": "\\b([A-Za-z_][A-Za-z0-9_]*)\\s*(?=\\()"
        }
      ]
    },
    "operators": {
      "patterns": [
        {
          "name": "keyword.operator.assignment.raytask",
          "match": "(\\+|\\-|\\*|/|%|\\&|\\||\\^|<<|>>)?="
        },
        {
          "name": "keyword.operator.comparison.raytask",
          "match": "(==|!=|<=|>=|<|>)"
        },
        {
          "name": "keyword.operator.logical.raytask",
          "match": "(\\&\\&|\\|\\||!)"
        },
        {
          "name": "keyword.operator.null-coalescing.raytask",
          "match": "\\?\\?"
        },
        {
          "name": "keyword.operator.arrow.raytask",
          "match": "(=>|->)"
        }
      ]
    }
  }
}
