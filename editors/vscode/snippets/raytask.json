{
  "Main": {
    "prefix": "main",
    "body": [
      "import bstd.io;",
      "",
      "void Main() {",
      "\t$0",
      "}"
    ],
    "description": "RayTask entry point"
  },
  "Class": {
    "prefix": "class",
    "body": [
      "export class ${1:Name} {",
      "\t${2:int} ${3:field};",
      "",
      "\tnew(${3:field}: ${2:int}) {",
      "\t\tthis.${3:field} = ${3:field};",
      "\t}",
      "",
      "\t${4:void} ${5:Method}() {",
      "\t\t$0",
      "\t}",
      "}"
    ],
    "description": "export class"
  },
  "Struct": {
    "prefix": "struct",
    "body": [
      "struct ${1:Name} {",
      "\t${2:int} ${3:field};",
      "",
      "\tnew(${3:field}: ${2:int}) {",
      "\t\tthis.${3:field} = ${3:field};",
      "\t}",
      "}"
    ]
  },
  "Function": {
    "prefix": "fn",
    "body": [
      "${1:void} ${2:Name}(${3:args}) {",
      "\t$0",
      "}"
    ]
  },
  "Async function": {
    "prefix": "async",
    "body": [
      "async ${1:void} ${2:Name}() {",
      "\tawait Task.Delay(${3:100});",
      "\t$0",
      "}"
    ]
  },
  "Test": {
    "prefix": "test",
    "body": [
      "[test]",
      "void Test${1:Name}() {",
      "\tassert(${2:true});",
      "\t$0",
      "}"
    ]
  },
  "For": {
    "prefix": "for",
    "body": [
      "for (var ${1:i} = 0; ${1:i} < ${2:n}; ${1:i}++) {",
      "\t$0",
      "}"
    ]
  },
  "Foreach": {
    "prefix": "foreach",
    "body": [
      "foreach (var ${1:item} in ${2:list}) {",
      "\t$0",
      "}"
    ]
  },
  "If": {
    "prefix": "if",
    "body": [
      "if (${1:cond}) {",
      "\t$0",
      "}"
    ]
  },
  "Match Result": {
    "prefix": "match",
    "body": [
      "match (${1:result}) {",
      "\tOk(v) => { $0 },",
      "\tError(e) => { print(e); }",
      "}"
    ]
  },
  "Print": {
    "prefix": "print",
    "body": "print(${\"${1:msg}\"});",
    "description": "print / interpolated print"
  },
  "Import io": {
    "prefix": "impio",
    "body": "import bstd.io;"
  },
  "Import collections": {
    "prefix": "impcol",
    "body": "import bstd.collections;"
  },
  "Property": {
    "prefix": "prop",
    "body": [
      "property ${1:Name}: ${2:int} {",
      "\tget { return this.${3:field}; }",
      "\tset { this.${3:field} = value; }",
      "}"
    ]
  },
  "Using Dispose": {
    "prefix": "using",
    "body": [
      "using (${1:var} ${2:resource} = ${3:expr}) {",
      "\t$0",
      "}"
    ],
    "description": "using statement (auto-dispose)"
  },
  "Try Catch typed": {
    "prefix": "try",
    "body": [
      "try {",
      "\t$0",
      "} catch (${1:e}: ${2:ExceptionType}) {",
      "\tprint(${1:e});",
      "} catch {",
      "\t// fallback",
      "}"
    ],
    "description": "try-catch with typed exception"
  },
  "Try Catch Finally": {
    "prefix": "tryf",
    "body": [
      "try {",
      "\t$0",
      "} catch (${1:e}) {",
      "\tprint(${1:e});",
      "} finally {",
      "\t// cleanup",
      "}"
    ],
    "description": "try-catch-finally"
  },
  "Switch with when guard": {
    "prefix": "switchw",
    "body": [
      "switch (${1:value}) {",
      "\tcase ${2:pattern} when ${3:guard}: {",
      "\t\t$0",
      "\t\tbreak;",
      "\t}",
      "\tdefault: {",
      "\t\tbreak;",
      "\t}",
      "}"
    ],
    "description": "switch with when guard"
  },
  "Block Lambda": {
    "prefix": "lambda",
    "body": "(${1:x}) => { ${0:/* body */} }",
    "description": "block lambda expression"
  },
  "DateTime.Now": {
    "prefix": "dtnow",
    "body": "DateTime.Now",
    "description": "DateTime.Now property"
  },
  "DateTime.UtcNow": {
    "prefix": "dtutc",
    "body": "DateTime.UtcNow",
    "description": "DateTime.UtcNow property"
  },
  "TimeSpan.FromSeconds": {
    "prefix": "tss",
    "body": "TimeSpan.FromSeconds(${1:seconds})",
    "description": "TimeSpan.FromSeconds factory"
  },
  "TimeSpan properties": {
    "prefix": "tsp",
    "body": [
      "var ${1:ts} = TimeSpan.FromSeconds(${2:0});",
      "${1:ts}.TotalSeconds",
      "${1:ts}.TotalMinutes",
      "${1:ts}.TotalHours",
      "${1:ts}.TotalDays",
      "${1:ts}.TotalMilliseconds"
    ],
    "description": "TimeSpan with all properties"
  },
  "GC.Collect": {
    "prefix": "gc",
    "body": "GC.Collect()",
    "description": "Explicit garbage collection"
  },
  "Nullable check": {
    "prefix": "nif",
    "body": "if (${1:obj} != null) {\n\t${1:obj}.${2:member};\n}",
    "description": "null-safe guard pattern"
  },
  "Interface": {
    "prefix": "interface",
    "body": [
      "interface ${1:IName} {",
      "\t${2:void} ${3:Method}(${4:args});",
      "\t$0",
      "}"
    ],
    "description": "interface definition"
  },
  "Extension method": {
    "prefix": "ext",
    "body": [
      "export void ${1:MethodName}(this ${2:Type} self, ${3:args}) {",
      "\t$0",
      "}"
    ],
    "description": "extension method"
  },
  "Operator overload": {
    "prefix": "op",
    "body": [
      "operator ${1:+}(${2:Type} a, ${2:Type} b): ${2:Type} {",
      "\treturn /* result */;",
      "}"
    ],
    "description": "operator overload"
  }
}
