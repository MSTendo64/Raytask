// bstd.async — Task / async-await (implemented as VM natives + event-loop)

export class Task {
    /// Suspend for `milliseconds`, returning a Task that completes with null.
    export static Task Delay(milliseconds: int);
    /// Schedule `fn` on the event-loop; returns a Task for its result.
    export static Task Run(fn: dyn);
    /// Wait until all tasks complete; result is an array of results.
    export static Task WhenAll(tasks: dyn[]);
    /// Complete when any task completes; result is the completed task result.
    export static Task WhenAny(tasks: dyn[]);
}

export class Task<T> {
    property Result: T { get; }
}

export class CancellationToken {
    property IsCancellationRequested: bool { get; }
    void ThrowIfCancellationRequested();
}

export class CancellationTokenSource {
    export static CancellationTokenSource New();
    property Token: CancellationToken { get; }
    void Cancel();
}

export class TaskGroup {
    export static TaskGroup New();
    Task Run(fn: dyn);
    Task WhenAll();
    Task WhenAny();
    void Cancel();
}
