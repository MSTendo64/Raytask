// bstd — notes for FFI (see language attributes, not loaded as .rt)

// [DllImport: "lib.so"] / [link: "lib.dll"]  — load shared library (no gcc)
// [bind: "header.h"] / [include: "header.h"] — parse C prototypes → FFI imports
// [c: "..."] / [cembed: "..."]              — compile embedded C (needs gcc/clang/cl)
// [abi: "cdecl"|"stdcall"|"system"]         — calling convention
// [export: "c_name"]                        — export RayTask fn for C / rename symbol
//
// Prefer headers + prebuilt DLLs/SOs — fully inside RayTask, no C compiler:
//   [DllImport: "kernel32.dll"]
//   [bind: "win_time.h"]
//   void Main() { print(GetTickCount()); }
//
// Or generate decls:
//   raytask bind win_time.h --lib kernel32.dll
