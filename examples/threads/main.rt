import bstd.io;

// ── Пример 1: два потока, синхронизация через Mutex ──────────────────────────
//
// Mutex.New()      → создать мьютекс (хранит одно значение)
// mx.Lock()        → считать значение (блокирует если занят)
// mx.Unlock(value) → записать значение и освободить
// mx.TryLock()     → не блокировать, вернуть null если занят

void MutexDemo() {
    var mx = Mutex.New();
    mx.Unlock(0);          // начальное значение счётчика

    // Поток 1: инкрементирует 5 раз
    var t1 = Thread.Run(() => {
        for (var i = 0; i < 5; i++) {
            var cur = mx.Lock();
            mx.Unlock(cur + 1);
        }
    });

    // Поток 2: инкрементирует ещё 5 раз
    var t2 = Thread.Run(() => {
        for (var i = 0; i < 5; i++) {
            var cur = mx.Lock();
            mx.Unlock(cur + 1);
        }
    });

    t1.Wait();
    t2.Wait();

    var result = mx.Lock();
    print($"Mutex counter = {result}");   // ожидаем 10
}

// ── Пример 2: канал producer / consumer ──────────────────────────────────────
//
// Channel.New()      → создать канал
// ch.Send(value)     → отправить (блокирует если читатель не готов)
// ch.Recv()          → получить (блокирует до появления данных)
// ch.TryRecv()       → не блокировать, вернуть null если пусто
// ch.Close()         → закрыть (Recv вернёт null после опустошения)

void ChannelDemo() {
    var ch = Channel.New();

    var producer = Thread.Run(() => {
        for (var i = 1; i <= 5; i++) {
            ch.Send(i * i);
        }
        ch.Close();
    });

    // Consumer в главном потоке
    while (true) {
        var v = ch.Recv();
        if (IsNull(v)) { break; }
        print($"received square: {v}");
    }

    producer.Wait();
    print("Channel demo done");
}

void Main() {
    MutexDemo();
    ChannelDemo();
}
