import bstd.io;
import bstd.collections;

void Main() {
    var nums = new List<int> { 1, 2, 3, 4, 5, 6 };
    var evens = nums.Where((x) => x % 2 == 0);
    print(evens.Count);
    var squares = nums.Select((x) => x * x);
    print(squares.Sum());
    assert(nums.Any((x) => x > 5));
    assert(nums.All((x) => x > 0));
    print("linq ok");
}
